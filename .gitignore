# Changing this file? .pubignore repeats these entries and REPLACES this file
# when pub builds the package — update it too, or the entry you add here still
# ships to pub.dev.

.DS_Store
.dart_tool/
.packages
build/
pubspec.lock
# compare/ is an app: its lockfile pins the vector_map_tiles renderer it measures.
!compare/pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.omc/
coverage/
