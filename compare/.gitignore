# Platform scaffolds are generated by the run scripts (`flutter create`), not
# checked in; only web/ is, because CI builds the demo from it. `flutter
# create` also drops an analysis_options.yaml that would override the repo
# lints and a default widget test for an app this is not — the scripts delete
# both, and they stay ignored in case anyone runs it by hand.
android/
ios/
linux/
macos/
windows/
.metadata
analysis_options.yaml
test/
README.md.orig

# Recorded OpenFreeMap tiles (tool/lab_server.dart --cache) and raw
# screenshots. The processed results in results/ are checked in.
.lab-cache/
results/raw/**/shots/

# Playwright, for the web runs.
tool/node_modules/
tool/package-lock.json

# Lab server logs from the run scripts.
.lab-*.log
