# Files excluded from the published package.
#
# NOTE: pub uses .pubignore *instead of* .gitignore for this directory, not in
# addition to it — so every .gitignore entry has to be repeated here. Keep the
# two in sync when either changes.

# --- mirrors .gitignore ---
.DS_Store
.dart_tool/
.packages
build/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.omc/
coverage/

# --- agent-facing documentation (useful in the repo, noise in the tarball) ---
AGENTS.md
CLAUDE.md

# --- flat screenshot originals (kept in the repo; pub.dev shows the framed ones) ---
screenshots/munich-liberty.webp
screenshots/zermatt-hillshade.webp
screenshots/munich-dark.webp
