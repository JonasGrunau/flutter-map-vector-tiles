# Generated platform scaffolds — recreate with
# `flutter create --platforms=ios .` (see README.md).
# `flutter create` also drops an analysis_options.yaml (which would override
# the repo lints) and a default widget_test.dart (which does not compile
# against this app) — delete both if you regenerate.
analysis_options.yaml
# test/* rather than test/: an ignored *directory* cannot have files
# re-included from inside it, and the anchor-jump evidence test below
# is ours, not scaffold droppings.
test/*
!test/anchor_continuity_test.dart

android/
ios/
linux/
macos/
web/
windows/
